generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model categories {
  id          BigInt     @id @default(autoincrement())
  nom         String     @db.VarChar(255)
  slug        String?    @unique @db.VarChar(255)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  produits    produits[]
}

model commandes {
  id             BigInt        @id @default(autoincrement())
  utilisateur_id BigInt?
  statut         String?       @db.VarChar(50)
  largeur        String?       @db.VarChar(100)
  longueur       String?       @db.VarChar(100)
  couleur        String?       @db.VarChar(100)
  type_bois      String?       @db.VarChar(100)
  duree          Int?
  id_produit     BigInt?
  quantite       Int?          @default(1)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  utilisateurs   utilisateurs? @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produits       produits?     @relation(fields: [id_produit], references: [id], onDelete: SetNull, onUpdate: NoAction)
  facture        facture[]
}

model facture {
  id_facture     BigInt     @id @default(autoincrement())
  numFacture     String?    @db.VarChar(100)
  date_emission  DateTime?  @default(now()) @db.Timestamp(6)
  date_paiement  DateTime?  @db.Timestamp(6)
  id_commande    BigInt?
  id_utilisateur BigInt?
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  commandes      commandes? @relation(fields: [id_commande], references: [id], onDelete: Cascade, onUpdate: NoAction)
  utilisateurs   utilisateurs? @relation(fields: [id_utilisateur], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model produits {
  id              BigInt            @id @default(autoincrement())
  categorie_id    BigInt?
  nom             String            @db.VarChar(255)
  slug            String?           @db.VarChar(255)
  description     String?
  prix            Decimal?          @db.Decimal(10, 2)
  vedette         Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  categories      categories?       @relation(fields: [categorie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produits_images produits_images[]
  commandes       commandes[]
}

model produits_images {
  id         BigInt    @id @default(autoincrement())
  produit_id BigInt?
  url_image  String?   @db.VarChar(255)
  principale Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  produits   produits? @relation(fields: [produit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model utilisateurs {
  id         BigInt      @id @default(autoincrement())
  nom        String?     @db.VarChar(255)
  email      String?     @unique @db.VarChar(255)
  mot_passe  String?     @db.VarChar(255)
  role       String?     @db.VarChar(50)
  adresse    String?     @db.VarChar(255)
  telephone  String?
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  commandes  commandes[]
  factures   facture[]
}