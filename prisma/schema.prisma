generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://postgres.winipbubhxuhmgrakefl:Paw%402002%40Pwa@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"
}

model categories {
  id          BigInt     @id @default(autoincrement())
  nom         String     @db.VarChar(255)
  slug        String?    @unique @db.VarChar(255)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  produits    produits[]
}

model commandes {
  id           BigInt            @id @default(autoincrement())
  client_id    BigInt?
  codeSuivi    String?           @unique @map("code_suivi")
  clientNom    String?           @db.VarChar(255)
  clientTel    String?           @db.VarChar(100)
  clientEmail  String?           @db.VarChar(255)
  adresse      String?           @db.VarChar(255)
  prix_total   Decimal?          @db.Decimal(10, 2)
  statut       String?           @db.VarChar(50)
  note         String?
  created_at   DateTime?         @default(now()) @db.Timestamp(6)
  largeur      String?           @db.VarChar(100)
  longueur     String?           @db.VarChar(100)
  couleur      String?           @db.VarChar(100)
  type_bois    String?           @db.VarChar(100)
  items        ArticleCommande[]
  facture      facture[]
}

model ArticleCommande {
  id          BigInt     @id @default(autoincrement())
  commande_id BigInt?
  produit_id  BigInt?
  quantite    Int?       @default(1)
  commande    commandes? @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produit     produits?  @relation(fields: [produit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model facture {
  id             BigInt        @id @default(autoincrement())
  commande_id    BigInt?
  utilisateur_id BigInt?
  numero_facture String?       @db.VarChar(100)
  date_emission  DateTime?     @db.Timestamp(6)
  date_paiement  DateTime?     @db.Timestamp(6)
  montant_totale Decimal?      @db.Decimal(10, 2)
  statut         String?       @db.VarChar(50)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  nomcomplete    String?       @db.VarChar(255)
  adresse        String?       @db.VarChar(255)
  telephone      String?
  email          String?       @db.VarChar(255)
  commandes      commandes?    @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  utilisateurs   utilisateurs? @relation(fields: [utilisateur_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model produits {
  id              BigInt            @id @default(autoincrement())
  categorie_id    BigInt?
  nom             String            @db.VarChar(255)
  slug            String?           @db.VarChar(255)
  description     String?
  prix            Decimal?          @db.Decimal(10, 2)
  vedette         Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  categories      categories?       @relation(fields: [categorie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produits_images produits_images[]
  ArticleCommande ArticleCommande[]
}

model produits_images {
  id         BigInt    @id @default(autoincrement())
  produit_id BigInt?
  url_image  String?   @db.VarChar(255)
  principale Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  produits   produits? @relation(fields: [produit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model utilisateurs {
  id         BigInt    @id @default(autoincrement())
  nom        String?   @db.VarChar(255)
  email      String?   @unique @db.VarChar(255)
  mot_passe  String?   @db.VarChar(255)
  role       String?   @db.VarChar(50)
  adresse    String?   @db.VarChar(255)
  telephone  String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  factures   facture[]
}

model Contact {
  id        BigInt   @id @default(autoincrement())
  nom       String   @map("nom_complet")
  email     String
  telephone String?
  objet     String   // e.g., "Demande de Devis", "Question Technique"
  message   String   @db.Text
  statut    String   @default("Non lu") // enum: "Non lu", "Lu", "Traité"
  createdAt DateTime @default(now()) @map("created_at")
}
