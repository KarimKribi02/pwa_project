generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model articles_commandes {
  id          BigInt     @id @default(autoincrement())
  commande_id BigInt?
  produit_id  BigInt?
  quantite    Int?
  prix        Decimal?   @db.Decimal(10, 2)
  commandes   commandes? @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produits    produits?  @relation(fields: [produit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model categories {
  id          BigInt     @id @default(autoincrement())
  nom         String     @db.VarChar(255)
  slug        String?    @unique @db.VarChar(255)
  description String?
  created_at  DateTime?  @default(now()) @db.Timestamp(6)
  produits    produits[]
}

model commandes {
  id                 BigInt               @id @default(autoincrement())
  client_id          BigInt?
  prix_total         Decimal?             @db.Decimal(10, 2)
  statut             String?              @db.VarChar(50)
  note               String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  largeur            String?              @db.VarChar(100)
  longueur           String?              @db.VarChar(100)
  couleur            String?              @db.VarChar(100)
  type_bois          String?              @db.VarChar(100)
  articles_commandes articles_commandes[]
  utilisateurs       utilisateurs?        @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  facture            facture[]
}

model facture {
  id             BigInt     @id @default(autoincrement())
  commande_id    BigInt?
  numero_facture String?    @db.VarChar(100)
  date_emission  DateTime?  @db.Timestamp(6)
  date_paiement  DateTime?  @db.Timestamp(6)
  montant_totale Decimal?   @db.Decimal(10, 2)
  statut         String?    @db.VarChar(50)
  created_at     DateTime?  @default(now()) @db.Timestamp(6)
  nomcomplete    String?    @db.VarChar(255)
  adresse        String?    @db.VarChar(255)
  telephone      String?
  email          String?    @db.VarChar(255)
  commandes      commandes? @relation(fields: [commande_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model produits {
  id                 BigInt               @id @default(autoincrement())
  categorie_id       BigInt?
  nom                String               @db.VarChar(255)
  slug               String?              @db.VarChar(255)
  description        String?
  prix               Decimal?             @db.Decimal(10, 2)
  vedette            Boolean?             @default(false)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  articles_commandes articles_commandes[]
  categories         categories?          @relation(fields: [categorie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produits_images    produits_images[]
}

model produits_images {
  id         BigInt    @id @default(autoincrement())
  produit_id BigInt?
  url_image  String?   @db.VarChar(255)
  principale Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  produits   produits? @relation(fields: [produit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model utilisateurs {
  id         BigInt      @id @default(autoincrement())
  nom        String?     @db.VarChar(255)
  email      String?     @unique @db.VarChar(255)
  mot_passe  String?     @db.VarChar(255)
  role       String?     @db.VarChar(50)
  created_at DateTime?   @default(now()) @db.Timestamp(6)
  commandes  commandes[]
}
